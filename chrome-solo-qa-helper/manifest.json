{
  "manifest_version": 3,
  "name": "Claude Eval → SOLO-QA",
  "version": "1.4.6",
  "minimum_chrome_version": "106",
  "description": "将本地 Claude Eval Console 的单轮或 Pair-wise GSB 数据提交到 SOLO-QA，并同步质检状态。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://solo2.jzxhnh.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
